# Rename/copy to .env locally — never commit .env or service account JSON.

# Full service account JSON as a single line (required).
# On Render: paste minified JSON into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"iraqi-fiber-academy","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@iraqi-fiber-academy.iam.gserviceaccount.com"}

PORT=3000
HOST_ORIGIN=https://iraqi-fiber-academy.web.app
